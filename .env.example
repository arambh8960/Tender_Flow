# ─────────────────────────────────────────────────────────────────────────────
# TenderFlow — environment template
#
# Copy to .env and fill in. NEVER commit .env: it is gitignored, and every
# value below is either a secret or environment-specific.
#
# Three audiences, and the split matters:
#
#   VITE_*        compiled INTO the browser bundle. Anything here is public
#                 the moment you deploy. Only ever put publishable values here.
#   server-only   read by the Node API. Never exposed to the browser.
#   tooling-only  read by scripts/ for migrations and one-off data moves.
#
# The build is asserted against this split: `npm run build` output is scanned
# for service-role material, and the API refuses to start in production if a
# required value is missing (see server/config/env.ts).
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════
#  FRONTEND — safe to ship in the bundle
#  Platform: set these on Vercel (or whatever serves the static build).
# ═══════════════════════════════════════════════════════════════════════════

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Publishable ("anon") key. Row Level Security is what protects data behind
# this key — it is designed to be public. Must NOT be a service-role key;
# src/services/supabase/client.ts refuses to start if it detects one.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Origin of the backend API.
#   development : leave blank (defaults to http://localhost:3001)
#   production  : the deployed API origin, e.g. https://api.tenderflow.example
VITE_API_BASE_URL=

# Google OAuth client id, only if the Google sign-in button is enabled.
# This is a public identifier, not a secret.
VITE_GOOGLE_CLIENT_ID=

# Which email sign-in experience this deployment offers. This MUST match the
# Supabase email template, because the API call is identical either way and
# the frontend cannot tell what was mailed:
#
#   magic_link  (default) the stock template, containing {{ .ConfirmationURL }}.
#               The UI says "check your email"; the link lands on /auth/callback.
#   otp         the Magic Link template has been edited to include {{ .Token }}.
#               The UI asks for the 6-digit code.
#
# Setting this to otp without editing the template shows a code box for an
# email that contains no code. See README §7.
VITE_EMAIL_AUTH_MODE=magic_link


# ═══════════════════════════════════════════════════════════════════════════
#  BACKEND — server process only, never sent to a browser
#  Platform: set these on Render / Railway / Fly, not on the frontend host.
# ═══════════════════════════════════════════════════════════════════════════

# Same project as VITE_SUPABASE_URL.
SUPABASE_URL=

# Same value as VITE_SUPABASE_PUBLISHABLE_KEY. The API uses it to build a
# per-request client carrying the caller's JWT, so RLS applies to server
# queries exactly as it does in the browser.
SUPABASE_ANON_KEY=

# ⚠ BYPASSES ROW LEVEL SECURITY ENTIRELY.
# Used only where a privileged action has no user in the loop: writing audit
# rows (which must not be forgeable), vault PIN/TOTP records, and member
# removal. Every query made with it carries an explicit organization_id,
# because the database no longer enforces tenancy for it.
# Required in production — the API refuses to boot without it.
SUPABASE_SERVICE_ROLE_KEY=

# Port the API listens on. Most platforms inject this.
PORT=3001

# production | development | test. Production enables the strict config check.
APP_ENV=development

# Comma-separated browser origins allowed to call the API. There is no
# wildcard fallback: in production an empty value means no browser can reach
# the API at all, which is deliberate.
#   development : http://localhost:5173,http://127.0.0.1:5173
#   production  : https://app.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ── AI providers ────────────────────────────────────────────────────────────
# Absent keys degrade one feature; they do not stop the server booting.

# Gemini: structural RFP parsing. A second key enables round-robin rotation.
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# Groq: buyer-added-terms extraction and the in-app copilot.
GROQ_API_KEY=

# ConvertAPI: optional PDF → DOCX conversion of tender documents.
CONVERT_API_SECRET=

# Google OAuth client id, server side, if Google sign-in is enabled.
GOOGLE_CLIENT_ID=


# ── Discovery browser (Puppeteer) ───────────────────────────────────────────

# Headless everywhere except deliberate local debugging. Any value other than
# "false" is treated as headless.
PUPPETEER_HEADLESS=true

# Path to a system Chromium. Required on hosts that do not ship one, and on
# slim container images where the bundled download is skipped.
#   Debian/Ubuntu image : /usr/bin/chromium
#   Alpine              : /usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=

# Per-navigation timeout in milliseconds.
PUPPETEER_NAV_TIMEOUT_MS=30000


# ── Maps (optional) ─────────────────────────────────────────────────────────
# Distance is computed from a bundled coordinate gazetteer plus Haversine, so
# no provider is required. These exist for a future routed-distance provider.
MAPS_PROVIDER=none
MAPS_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
#  TOOLING — migrations and one-off data moves. Not needed at runtime.
# ═══════════════════════════════════════════════════════════════════════════

# Direct Postgres connection, used by `npm run db:migrate` and the inspection
# scripts. Supabase exposes two endpoints and they are NOT interchangeable:
#
#   SUPABASE_POOLER_URL  Supavisor session pooler. Resolves over IPv4, so this
#                        is the one that works from most CI runners and from
#                        IPv4-only networks. PREFERRED — scripts try it first.
#                        Username form: postgres.<project-ref>
#
#   SUPABASE_DB_URL      Direct connection. IPv6-ONLY on current projects, so
#                        it fails with ENOTFOUND on an IPv4-only host.
#                        Username form: postgres
#
# Find both under: Supabase dashboard → Project Settings → Database.
# If the password contains reserved characters it must be percent-encoded.
SUPABASE_POOLER_URL=
SUPABASE_DB_URL=


# ── Legacy local Postgres ───────────────────────────────────────────────────
# ONLY used by scripts/inspect.mjs and scripts/seed-organization.mjs to read
# the pre-Supabase database during a one-time migration. The application does
# not use these; leave blank on a fresh install.
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tenderflow


# ═══════════════════════════════════════════════════════════════════════════
#  END-TO-END TESTS (optional) — see tests/e2e/README.md
#  Point these at a DISPOSABLE project. The suite creates and deletes users,
#  organisations and storage objects.
# ═══════════════════════════════════════════════════════════════════════════

# Domain for generated test accounts. Must pass Supabase's email validator —
# example.com and .test are rejected.
E2E_EMAIL_DOMAIN=tenderflow-e2e.com

# Target an already-running app instead of letting Playwright build and serve.
E2E_BASE_URL=

# Backend origin for the API-level role assertions.
E2E_API_BASE_URL=http://localhost:3001
