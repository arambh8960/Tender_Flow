{
  "name": "tenderflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:server",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "db:inspect": "node scripts/inspect.mjs",
    "db:verify": "node scripts/verify-schema.mjs",
    "test": "vitest run",
    "test:rls": "tsx --test --test-concurrency=1 \"tests/rls/**/*.test.mjs\"",
    "test:unit": "vitest run tests/unit",
    "db:types": "node scripts/gen-types.mjs",
    "db:seed": "tsx scripts/seed-organization.mjs",
    "test:api": "tsx --test --test-concurrency=1 \"tests/api/**/*.test.mjs\"",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:discovery": "vitest run tests/unit/discoveryQualification.test.ts tests/unit/gemParser.test.ts",
    "test:security": "vitest run tests/unit/security.test.ts tests/integration/api.test.ts",
    "test:agents": "vitest run tests/unit/financialAgent.test.ts tests/unit/technicalAgent.test.ts",
    "test:tenancy": "npm run test:rls && npm run test:api",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:all": "npm run typecheck:all && npm run test && npm run test:e2e",
    "start": "node --import tsx server/index.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.5.0",
    "@react-oauth/google": "^0.13.4",
    "@supabase/supabase-js": "^2.115.0",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "convertapi": "^1.15.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^12.34.0",
    "google-auth-library": "^10.5.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.3.0",
    "json5": "^2.2.3",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.564.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "4.5.136",
    "pg": "^8.18.0",
    "puppeteer": "^24.37.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.1.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.11",
    "postcss": "^8.4.38",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
